# Copy to .env.local. Never commit real values. No database is required yet.
SITE_URL=http://127.0.0.1:3000
# Delivery stays disabled unless every SMTP value and sender verification are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CREATOR_MAIL_FROM=
CREATOR_MAIL_TO=
CREATOR_SENDER_VERIFIED=false
# Dedicated Creator inbox and verified sender only; never reuse an Expert CRM.
# Reserved server-only payment settings. Public checkout currently sends enquiries.
BANK_VERIFIED=false
BANK_RECIPIENT=
BANK_IBAN=
INVOICE_ENABLED=false
CRYPTO_VERIFIED=false
CRYPTO_CURRENCY=
CRYPTO_NETWORK=
CRYPTO_ADDRESS=
# Supabase is intentionally not connected; adding keys alone does not activate it.
